[Unit]
Description=PA Lottery Scratch Odds (sortable/searchable scratch-off odds board, LAN-bound)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pingywon
Group=pingywon
WorkingDirectory=/home/pingywon/pa-lottery-scratch-odds
Environment=PORT=8789
Environment=BIND=0.0.0.0
ExecStart=/usr/bin/python3 /home/pingywon/pa-lottery-scratch-odds/server.py
NoNewPrivileges=true
PrivateTmp=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
